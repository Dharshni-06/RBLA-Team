function getSmartFallbackResponse(userMessage = "") {
  const query = userMessage.toLowerCase().trim();

  // 1. Greetings
  if (/^(hi|hello|hey|greetings|good morning|good afternoon|good evening)\b/i.test(query)) {
    return "Hello! Welcome to TalkTribe, your AI assistant for our eco-friendly handcrafted e-commerce platform. How can I help you today with our products, custom design tools, or orders?";
  }

  // 2. Production Units / Artisans
  if (query.includes("unit 1") || query.includes("varnam")) {
    return "Entrepreneur Unit 1 (Varnam) specializes in artisan printing and color dyeing crafts. You can explore their beautiful printed creations across our textile collections on the website!";
  }
  if (query.includes("unit 2") || query.includes("siragugal")) {
    return "Entrepreneur Unit 2 (Siragugal) handles precision tailoring, stitching, and textile assembly. Browse their expert stitching craftsmanship in our Bags, Towels, and Bedsheets categories!";
  }
  if (query.includes("unit 3") || query.includes("vaagai")) {
    return "Entrepreneur Unit 3 (Vaagai) focuses on bamboo crafting, handmade paper product creation, and manual block printing. Check out our Bamboo Products and Handcrafted Paper Files to see their work!";
  }
  if (query.includes("unit") || query.includes("artisan") || query.includes("craft") || query.includes("entrepreneur")) {
    return "Our products are handcrafted across three specialized artisan units: Unit 1 (Varnam) for printing & dyeing, Unit 2 (Siragugal) for tailoring & stitching, and Unit 3 (Vaagai) for bamboo, paper files & block printing. Feel free to explore our About page or shop by artisan unit!";
  }

  // 3. Customization & Design Tools
  if (query.includes("custom") || query.includes("design") || query.includes("upload") || query.includes("personalize")) {
    return "We offer Interactive Customizers for Towels, Bags, Bedsheets, Napkins, Paper Files, Cup Coasters, and Bamboo products! You can also upload your own artwork directly on the 'Upload Design & Checkout' page to personalize your items.";
  }

  // 4. Products Offered
  if (query.includes("bag") || query.includes("tote") || query.includes("canvas")) {
    return "Our Eco-friendly Bags collection includes handcrafted tote bags, eco-cotton bags, and durable canvas bags. You can explore and customize them under the Bags section on our website!";
  }
  if (query.includes("towel") || query.includes("cotton towel")) {
    return "Our Premium Towels are handmade from 100% organic cotton for maximum softness and absorbency. Explore our Towels category or try the Interactive Towel Customizer to design your custom set!";
  }
  if (query.includes("bedsheet") || query.includes("linen") || query.includes("cover")) {
    return "We offer handcrafted bedsheets, covers, and dining linen made with organic fabrics. Head over to our Bedsheets & Linen page to browse patterns or create a bespoke design using our customizer!";
  }
  if (query.includes("napkin") || query.includes("dining")) {
    return "Elevate your dining space with our handcrafted Napkins & Dining Linen sets. Visit the Napkins section to view artisan dining essentials or customize your own table linen!";
  }
  if (query.includes("bamboo")) {
    return "Our Eco-friendly Bamboo Products include cutlery sets, organizers, and home decor crafted by Entrepreneur Unit 3 (Vaagai). Check out the Bamboo section to discover sustainable living items!";
  }
  if (query.includes("paper") || query.includes("file") || query.includes("folder")) {
    return "Our Handcrafted Paper Files & Folders are made from sustainable materials and manually block-printed by Unit 3 (Vaagai). Browse our Paper Products section for eco-friendly office and school supplies!";
  }
  if (query.includes("coaster") || query.includes("cup coaster")) {
    return "Our artisanal Cup Coaster sets add a touch of handcrafted elegance to your tabletop. Explore the Cup Coasters category or use our Cup Coaster Customizer to create custom sets!";
  }
  if (query.includes("product") || query.includes("item") || query.includes("buy") || query.includes("catalog") || query.includes("sell") || query.includes("offer")) {
    return "We offer Eco-friendly Bags, Premium Towels, Bedsheets & Linen, Dining Napkins, Bamboo Products, Handcrafted Paper Files, and Cup Coasters! You can browse all these items in our Products catalog or customize them using our interactive design tools.";
  }

  // 5. Orders, Shipping & Returns
  if (query.includes("bulk") || query.includes("corporate") || query.includes("wholesale") || query.includes("large order")) {
    return "We welcome corporate and wholesale bulk requests! You can place bulk orders directly on our 'Bulk Orders' page with custom artisan branding options for your organization.";
  }
  if (query.includes("track") || query.includes("status") || query.includes("order tracking") || query.includes("where is my order")) {
    return "You can easily track active orders by navigating to 'My Orders' -> 'Order Tracking' in your account. Standard delivery typically takes 3-7 business days.";
  }
  if (query.includes("ship") || query.includes("delivery") || query.includes("dispatch")) {
    return "Our standard shipping delivery time is 3-7 business days. Once dispatched, you can monitor your shipment status under 'My Orders' -> 'Order Tracking'.";
  }
  if (query.includes("return") || query.includes("refund") || query.includes("exchange")) {
    return "Eligible return requests can be filed within 7 days of delivery via our 'Return Order' page. Please visit the Return Order section on our website for step-by-step assistance!";
  }

  // 6. Support & Fraud
  if (query.includes("fraud") || query.includes("scam") || query.includes("suspicious")) {
    return "Your safety is our priority! If you encounter suspicious activity, please submit a report immediately using our 'Report Fraud' form, or contact support via our Help Center.";
