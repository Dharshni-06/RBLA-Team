  const storeKeywords = ["product", "bag", "towel", "bedsheet", "linen", "napkin", "bamboo", "file", "folder", "coaster", "custom", "order", "ship", "delivery", "return", "support", "contact", "unit", "artisan", "varnam", "siragugal", "vaagai", "talktribe", "store", "shop", "price", "cost", "pay"];
  const isRelated = storeKeywords.some(kw => query.includes(kw));

  if (!isRelated) {
    return "I am TalkTribe, your AI assistant for our eco-friendly handcrafted e-commerce platform. I am here to assist with questions regarding our products, customization options, orders, shipping, and services. How can I help you explore our handcrafted collection today?";
  }

  return "I'm happy to help you with our eco-friendly handcrafted products, interactive customizers, bulk orders, shipping, or returns! Please let me know what you'd like to explore on our website.";
}

exports.getChatResponse = async (req, res) => {
  try {
    const { message } = req.body;
    if (!message) {
      return res.status(400).json({ error: "Message is required" });
    }

    const apiKey = process.env.OPENAI_API_KEY || process.env.POLLINATIONS_API_KEY;
    const hasValidOpenAIKey = apiKey && apiKey.trim() !== "" && !apiKey.includes("YOUR_OPENAI_KEY_HERE");

    // 1. Try OpenAI API if key is present
    if (hasValidOpenAIKey) {
      try {
        const openai = new OpenAI({ apiKey: apiKey.trim() });
        const completion = await openai.chat.completions.create({
          model: "gpt-3.5-turbo",
          messages: [
            { role: "system", content: SYSTEM_PROMPT },
            { role: "user", content: message }
          ]
        });

        if (completion?.choices?.[0]?.message?.content) {
          return res.json({ reply: completion.choices[0].message.content });
        }
      } catch (openAiErr) {
        console.log("OpenAI API call failed, falling back to Pollinations AI / Smart Fallback:", openAiErr?.message);
      }
    }

    // 2. Pollinations AI Fallback
    try {
      const response = await axios.post("https://text.pollinations.ai/", {
        messages: [
          { role: "system", content: SYSTEM_PROMPT },
          { role: "user", content: message }
        ],
        model: "openai"
      }, {
        headers: { "Content-Type": "application/json" },
        timeout: 3000
      });

      let replyText = "";
      if (typeof response.data === "string") {
        replyText = response.data;
      } else if (response.data?.reply) {
        replyText = response.data.reply;
      } else if (response.data?.choices?.[0]?.message?.content) {
        replyText = response.data.choices[0].message.content;
      }

      // Check if replyText is a Pollinations budget/API error message
      const isBudgetOrErrorMsg = replyText && (
        replyText.includes("budget") ||
        replyText.includes("pollinations") ||
        replyText.includes("API key") ||
        replyText.includes("quota") ||
        replyText.includes("limit") ||
        replyText.includes("Support") ||
        replyText.includes("enter.pollinations.ai") ||
        replyText.toLowerCase().includes("reached its budget")
      );

      if (replyText && replyText.trim().length > 0 && !isBudgetOrErrorMsg) {
        return res.json({ reply: replyText.trim() });
      }
    } catch (pollinationsError) {
      console.log("Pollinations AI unavailable, using Smart Fallback Response Handler:", pollinationsError?.message);
    }

    // 3. Local Smart Fallback Handler
    const smartReply = getSmartFallbackResponse(message);
    return res.json({ reply: smartReply });

  } catch (error) {
    console.error("Chatbot Controller Error:", error?.message || error);
    const fallbackReply = getSmartFallbackResponse(req.body?.message || "");
    return res.json({ reply: fallbackReply });
  }
};
